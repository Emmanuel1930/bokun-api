{{!-- Paste into Widget Builder > Code > Html, inside the existing <div class="widget-XXXXXX"> wrapper. --}}

<section class="aw-faq" data-bokun-id="{{bokunId}}" data-endpoint="{{endpoint}}" data-single-open="{{singleOpen}}">

  {{#if heading}}
  <h2 class="aw-faq__heading">{{heading}}</h2>
  {{/if}}

  {{!-- faqHtml is bound to the collection's `faq` field, so the Q&A is in the published HTML, not fetched. --}}
  <div class="aw-faq__list" data-aw-faq-list>{{{faqHtml}}}</div>

  {{#if faqSchema}}
  <script type="application/ld+json">{{{faqSchema}}}</script>
  {{/if}}

</section>
